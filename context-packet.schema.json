{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/ai-context-handoff-packet.json",
  "title": "AI Context Handoff Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "goal", "currentState", "nextAction", "verification"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "goal": { "type": "string", "minLength": 10 },
    "currentState": { "type": "string", "minLength": 10 },
    "nextAction": { "type": "string", "minLength": 10 },
    "decisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 3 }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
